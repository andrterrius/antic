# Copy to /etc/antidetect/api.env and edit:
#   mkdir -p /etc/antidetect
#   cp scripts/api/antidetect-api.env.example /etc/antidetect/api.env

ANTIDETECT_API_TOKEN=secret
ANTIDETECT_API_HOST=127.0.0.1
ANTIDETECT_API_PORT=18765

# Снаружи лучше nginx → 127.0.0.1:18765.
# Если нужен bind на все интерфейсы (осторожно):
# ANTIDETECT_API_HOST=0.0.0.0
